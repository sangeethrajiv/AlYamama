# Copy to .env and fill in. Never commit .env.
PORT=3000
CORS_ORIGINS=http://localhost:5173

# New ERP database (read-write)
PGHOST=localhost
PGPORT=5433
PGUSER=
PGPASSWORD=
PGDATABASE=accounting_26_test
PG_POOL_MAX=20

# Throwaway database used by `npm test` (dropped and recreated every run)
PGDATABASE_UNIT=accounting_26_test_unit

# Odoo 12 copy (READ-ONLY; only scripts/import-odoo.ts connects to it)
ODOO_PGHOST=localhost
ODOO_PGPORT=5433
ODOO_PGUSER=
ODOO_PGPASSWORD=
ODOO_PGDATABASE=
