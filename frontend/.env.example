# Copy to .env.local to connect the Contact Master module to the backend.
# Leave VITE_API_URL empty (or delete the file) to run on the sample data.
VITE_API_URL=http://localhost:3000/v2

# The backend's auth is still a stub: these become the X-User-Id /
# X-Company-Id / X-Allowed-Company-Ids headers. Leave the company ones empty to
# see every company's contacts.
VITE_API_USER_ID=1
VITE_API_COMPANY_ID=
VITE_API_ALLOWED_COMPANY_IDS=
